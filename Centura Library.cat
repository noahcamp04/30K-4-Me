                      <constraints>
                        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="ebf8-3df0-e096-a013" percentValue="false" includeChildSelections="false" includeChildForces="false"/>
                        <constraint type="min" value="1" field="selections" scope="parent" shared="true" id="267c-91a2-32a0-e181" percentValue="false" includeChildSelections="false" includeChildForces="false"/>
                      </constraints>
                      <selectionEntries>
                        <selectionEntry type="upgrade" import="true" name="Augurs of Weakness" hidden="false" id="d268-8478-6d0e-cf19" publicationId="817a-6288-e016-7469" page="161" collective="false">
                          <profiles>
                            <profile name="Augurs of Weakness" typeId="b46c-270c-d29e-f0ff" typeName="Ability" hidden="false" id="6167-4ea3-fae2-dbad">
                              <characteristics>
                                <characteristic name="Description" typeId="0982-427b-1d4a-d07c">When making an Armor Penetration roll against a target with Armour 11 or more on the facing targeted, a model with this special rule may add +1 to the Strength of the weapon used in the attack.</characteristic>
                              </characteristics>
                            </profile>
                          </profiles>
                          <costs>
                            <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0"/>
                          </costs>
                        </selectionEntry>
                        <selectionEntry type="upgrade" import="true" name="Icons of Resolve" hidden="false" id="ee27-f7ca-ad24-6c84" publicationId="817a-6288-e016-7469" page="161" collective="false">
                          <profiles>
                            <profile name="Icons of Resolve" typeId="b46c-270c-d29e-f0ff" typeName="Ability" hidden="false" id="e858-25b9-e27a-ad47">
                              <characteristics>
                                <characteristic name="Description" typeId="0982-427b-1d4a-d07c">This model gains +1 Leadership (to a maximum of 10) on any turn in which it, or a unit it is part of, is Charged by one or more enemy units.</characteristic>
                              </characteristics>
                            </profile>
                          </profiles>
                          <costs>
                            <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0"/>
                          </costs>
                        </selectionEntry>
                        <selectionEntry type="upgrade" import="true" name="Slayers of Kings" hidden="false" id="2e5b-e034-1a39-1383" publicationId="817a-6288-e016-7469" page="161" collective="false">
                          <profiles>
                            <profile name="Slayers of Kings" typeId="b46c-270c-d29e-f0ff" typeName="Ability" hidden="false" id="aa72-4ec9-fb9d-edbe">
                              <characteristics>
                                <characteristic name="Description" typeId="0982-427b-1d4a-d07c">This model may re-roll failed To Hit rolls of &apos;1&apos; when Engaged in combat with any model with a Weapon Skill of 5 or higher or in a Challenge with any model with a Weapon Skill of 5 or higher.</characteristic>
                              </characteristics>
                            </profile>
                          </profiles>
                          <costs>
                            <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0"/>
                          </costs>
                        </selectionEntry>
                        <selectionEntry type="upgrade" import="true" name="Hunter of Beasts" hidden="false" id="aa7f-7df1-d75b-c2ca" publicationId="817a-6288-e016-7469" page="161" collective="false">
                          <profiles>
                            <profile name="Hunter of Beasts" typeId="b46c-270c-d29e-f0ff" typeName="Ability" hidden="false" id="6e49-90b0-6bf4-331d">
                              <characteristics>
                                <characteristic name="Description" typeId="0982-427b-1d4a-d07c">This model may re-roll failed To Wound rolls of &apos;1&apos; when any enemy unit it is Engaged in combat with includes one or more models with a Toughness of 5, or any failed To Wound roll if the target&apos;s Toughness is 6 or higher.</characteristic>
                              </characteristics>
                            </profile>
                          </profiles>
                          <costs>
                            <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0"/>
                          </costs>
                        </selectionEntry>
                        <selectionEntry type="upgrade" import="true" name="Reaper of Hosts" hidden="false" id="0e97-4540-a59b-4b51" publicationId="817a-6288-e016-7469" page="161" collective="false">
                          <profiles>
                            <profile name="Reaper of Hosts" typeId="b46c-270c-d29e-f0ff" typeName="Ability" hidden="false" id="8931-ecbc-dcd4-38c0">
                              <characteristics>
                                <characteristic name="Description" typeId="0982-427b-1d4a-d07c">This model gains +1 Attack in any Fight sub-phase which they begin in base contact with more than one enemy model.</characteristic>
                              </characteristics>
                            </profile>
                          </profiles>
                          <costs>
                            <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0"/>
                          </costs>
                        </selectionEntry>
                        <selectionEntry type="upgrade" import="true" name="Breaker of Witches" hidden="false" id="624d-266b-dc3f-3929" publicationId="817a-6288-e016-7469" page="161" collective="false">
                          <profiles>
                            <profile name="Breaker of Witches" typeId="b46c-270c-d29e-f0ff" typeName="Ability" hidden="false" id="6eef-6b02-a6e0-863b">
                              <characteristics>
                                <characteristic name="Description" typeId="0982-427b-1d4a-d07c">This model may re-roll all To Hit and To Wound rolls in close combat when attacking an enemy unit that includes one or more models with the Daemon Unit Type or the Psyker or Corrupted Sub-type.</characteristic>
                              </characteristics>
                            </profile>
                          </profiles>
                          <costs>
                            <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0"/>
                          </costs>
                        </selectionEntry>
