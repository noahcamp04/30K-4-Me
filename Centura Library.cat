                <selectionEntry type="upgrade" import="true" name="Castellan" hidden="true" id="0806-a801-fb51-f255" publicationId="817a-6288-e016-7469" page="229" collective="false">
                  <modifiers>
                    <modifier type="set" value="false" field="hidden">
                      <conditionGroups>
                        <conditionGroup type="and">
                          <conditions>
                            <condition type="equalTo" value="0" field="selections" scope="force" childId="b5b7-3410-a8e5-95a6" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false"/>
                            <condition type="equalTo" value="1" field="selections" scope="force" childId="a0e1-f2c4-8bcd-0723" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false"/>
                            <condition type="instanceOf" value="0" field="selections" scope="ancestor" childId="25a2-7a52-632a-6b2c" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false"/>
                          </conditions>
                        </conditionGroup>
                      </conditionGroups>
                    </modifier>
                  </modifiers>
                  <profiles>
                    <profile name="Fire Support" typeId="b46c-270c-d29e-f0ff" typeName="Ability" hidden="false" id="e607-d78c-0f4a-6a65">
                      <characteristics>
                        <characteristic name="Description" typeId="0982-427b-1d4a-d07c">When making an attack with a Heavy weapon, a Castellan may increase the number of attacks made with that weapon by +1 when making a Shooting Attack (for example, a Castellan making a Shooting Attack with a Heavy 3 weapon would roll an additional dice for its attacks, rolling four dice in total). In addition, any Legion Heavy Support Squads in the same Detachment as a Castellan gain the Line Sub-type.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
