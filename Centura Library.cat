                  <selectionEntryGroups>
                    <selectionEntryGroup name="Orders of the Hekatonystika" id="24d2-818b-4d64-9c09" hidden="false" publicationId="817a-6288-e016-7469" page="161" collective="false" import="true">
                      <modifiers>
